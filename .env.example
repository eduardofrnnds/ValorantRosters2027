# Sem as duas variaveis abaixo: catalogo local SOMENTE LEITURA.
# Guia completo: docs/DEPLOY_VERCEL.md. Aplicar as oito migrations em ordem.
# Na Vercel, definir por ambiente ANTES do build; alteracoes exigem novo deploy.
# Usar um projeto Supabase separado para Preview e para Production.
# Preencha com valores reais do mesmo projeto. Chave publishable ou anon legada.
# Nunca use sb_secret_* ou service_role em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# /admin usa as mesmas variaveis publicas e Supabase Auth (email/senha).
# Sem configuracao, login indisponivel e acesso administrativo bloqueado.
# Nao ha senha fixa, usuario automatico ou chave service_role no aplicativo.
# Configure HTTPS em producao. Primeiro admin: docs/ADMIN_AUTH.md.

# Opcional: habilite somente depois de provisionar o bucket publico e suas
# politicas conforme docs/ADMIN_ORGANIZATIONS.md. Unico valor aceito:
# SUPABASE_ORGANIZATION_LOGOS_BUCKET=organization-logos
SUPABASE_ORGANIZATION_LOGOS_BUCKET=

# Foto de jogador: bucket publico e politicas em docs/ADMIN_PLAYERS.md.
# Unico valor aceito: player-photos. Deixe vazio sem Storage configurado.
SUPABASE_PLAYER_PHOTOS_BUCKET=

# Exclusiva do comando manual db:seed, nunca lida pelo app/navegador.
# Nao configurar na Vercel: migrations e seed sao passos manuais separados.
# URL PostgreSQL real com usuario autorizado, depois das migrations.
# O seed usa TLS com verificacao de certificado para hosts remotos.
DATABASE_URL=
