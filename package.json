{
  "name": "vct-roster-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "node scripts/verify-catalog-integration.mjs --skip-build",
    "test:integration": "node scripts/verify-catalog-integration.mjs --http-only --skip-build && node scripts/verify-catalog-integration.mjs --remote --http-only --skip-build && node scripts/verify-admin-access.mjs",
    "test:release": "node scripts/verify-release-http.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node --test tests/database.test.mjs tests/admin-security.test.mjs",
    "test:admin": "node scripts/verify-admin-access.mjs",
    "data:list": "node scripts/list-vct-2027.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-vct-2027.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "motion": "13.4.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.64.1",
    "postcss": "8.5.30",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
